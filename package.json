{
  "name": "converter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run prepare:assets",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node scripts/clean-build-assets.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "predesktop:dev": "npm run prepare:assets",
    "desktop:dev": "vite --config vite.desktop.config.ts",
    "predesktop:build": "npm run prepare:assets",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "postdesktop:build": "node scripts/clean-build-assets.mjs",
    "desktop": "tauri",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern desktop-dist --ignore-pattern src-tauri/target --ignore-pattern .next --ignore-pattern public/ocr --ignore-pattern public/pdf.worker.min.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20260731.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
